{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "paths": {
            "@/*": ["./resources/js/*"],
            "ziggy-js": ["./vendor/tightenco/ziggy"]
        },
        "allowJs": true,
        "checkJs": false
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.d.ts",
        "resources/js/Pages/Dashboard.vue",
        "resources/js/Components/StatusBadge.vue",
        "resources/js/Components/CustomerProgressBar.vue",
        "resources/js/Components/MetricCard.vue",
        "resources/js/Components/WinBackList.vue"
    ],
    "exclude": [
        "node_modules",
        "public",
        "resources/js/**/*.spec.ts",
        "resources/js/**/*.test.ts"
    ]
}
